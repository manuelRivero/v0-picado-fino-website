# =============================================================================
# Picado Fino Website — variables de entorno
# =============================================================================
#
# Clasificación:
#   BUILD-TIME  → NEXT_PUBLIC_*  (quedan en la imagen; pasar como --build-arg)
#   RUNTIME     → ninguna en este proyecto (toda la config va en build-time)
#   REFERENCIA  → DOMAIN, NPM_* (solo para DNS / Nginx Proxy Manager)
#
# =============================================================================

# --- Build-time (NEXT_PUBLIC_*) ---

# URL base del backend (menú, horarios, datos del negocio)
NEXT_PUBLIC_API=https://api.ejemplo.com/api

# URL pública del sitio (metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://picadofino.com

# IDs de negocio en el backend
NEXT_PUBLIC_PICADO_ID=
NEXT_PUBLIC_LA_ESQUINA_ID=

# WhatsApp (solo dígitos, sin +)
NEXT_PUBLIC_PICADO_FINO_PHONE=
NEXT_PUBLIC_LA_ESQUINA_PHONE=

# Google Places API (reseñas)
NEXT_PUBLIC_PLACES_KEY=

# Opcional: Place ID de Google. Si no se define, se resuelve por búsqueda de texto.
NEXT_PUBLIC_PLACES_PICADO_ID=
NEXT_PUBLIC_PLACES_ESQUINA_ID=

# --- Docker (build local + despliegue) ---

# Imagen publicada en Docker Hub
DOCKER_IMAGE=tuusuario/picado-fino-website:latest

# --- Solo referencia (no las usa el contenedor) ---

# Dominio configurado en DonWeb DNS y Nginx Proxy Manager
DOMAIN=picadofino.com

# Red Docker compartida con Nginx Proxy Manager (verificar: docker network ls)
NPM_NETWORK=proxy-network
