# Copiar en el VPS como /opt/apps/picado-fino-website/.env
# Solo se necesitan estas variables para docker-compose.prod.yml

DOMAIN=picadofino.com
DOCKER_IMAGE=tuusuario/picado-fino-website:latest
NPM_NETWORK=proxy-network

# Referencia: la API quedó embebida en la imagen al hacer docker build.
# Si cambia la URL del backend, hay que reconstruir y volver a publicar la imagen.
API=https://api.picadofino.com/api
